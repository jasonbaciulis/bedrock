{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "icons:heroicons": "rm -rf resources/svg/heroicons && mkdir -p resources/svg/heroicons && cp -R node_modules/heroicons/24/outline resources/svg/heroicons/outline && cp -R node_modules/heroicons/24/solid resources/svg/heroicons/solid && cp -R node_modules/heroicons/20/solid resources/svg/heroicons/mini",
        "icons:lucide": "rm -rf resources/svg/lucide && mkdir -p resources/svg/lucide && cp -R node_modules/lucide-static/icons/. resources/svg/lucide",
        "postinstall": "bun run icons:heroicons && bun run icons:lucide",
        "lint": "prettier \"resources/**/*.{js,css,scss,html,antlers.html,blade.php}\" --write && eslint \"resources/js\" --fix",
        "test:lint": "prettier \"resources/**/*.{js,css,scss,html,antlers.html,blade.php}\" --check && eslint \"resources/js\" --max-warnings=0"
    },
    "devDependencies": {
        "@alpinejs/anchor": "^3.16.0",
        "@alpinejs/collapse": "^3.16.0",
        "@alpinejs/focus": "^3.16.0",
        "@alpinejs/intersect": "^3.16.0",
        "@alpinejs/mask": "^3.16.0",
        "@alpinejs/persist": "^3.16.0",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "alpinejs": "^3.16.0",
        "concurrently": "^10.0.4",
        "embla-carousel": "^8.6.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-unicorn": "^73.0.0",
        "globals": "^17.9.0",
        "heroicons": "^2.2.0",
        "js-cookie": "^3.0.8",
        "laravel-vite-plugin": "^3.1.3",
        "lite-youtube-embed": "^0.3.4",
        "lucide-static": "^1.31.0",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "prettier-plugin-antlers": "^2.0.5",
        "prettier-plugin-blade": "^3.2.2",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.1"
    }
}
